# Discord control channel for X approvals/ops.
DISCORD_BOT_TOKEN=replace_with_dedicated_or_allowed_discord_bot_token
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOWED_USERS=576031815945420812
DISCORD_HIDE_SLASH_COMMANDS=true
DISCORD_HOME_CHANNEL=1509865603714908304
DISCORD_HOME_CHANNEL_NAME=nikechan-x
DISCORD_ALLOWED_GUILDS=replace_with_master_guild_id_if_needed

# Hermes inference.
HERMES_INFERENCE_PROVIDER=xai
HERMES_INFERENCE_MODEL=grok-3-mini
TZ=Asia/Tokyo

# X API credentials. Keep real values only in .env, never in git.
X_CONSUMER_KEY=replace_with_x_consumer_key
X_CONSUMER_SECRET=replace_with_x_consumer_secret
X_ACCESS_TOKEN=replace_with_x_access_token
X_ACCESS_TOKEN_SECRET=replace_with_x_access_token_secret

# Hermes inference and optional current-context search.
XAI_API_KEY=replace_with_xai_api_key

# Canonical memory/context adapters. Prefer public-safe read APIs/RPCs.
SUPABASE_URL=replace_with_supabase_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_or_limited_key
NIKECHAN_CORE_PATH=/opt/nikechan-core
NIKECHAN_X_RELEASE_MODE=dry-run
